# ============================================================
#  MALIBUBOT — Variables de entorno (Fase 1: eco de WhatsApp)
#  Copia este archivo a ".env" y complétalo para desarrollo local.
#  En Render, carga estas mismas variables en Settings -> Environment.
# ============================================================

# Puerto. En local puedes usar 3000; en Render se inyecta automaticamente.
PORT=3000

# --- WhatsApp Cloud API (Meta) ---
# Token de acceso (temporal para pruebas, o permanente de sistema para produccion)
WHATSAPP_TOKEN=

# ID del numero de telefono (Meta App -> WhatsApp -> API Setup -> Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=

# Token de verificacion del webhook: un valor secreto que TU inventas.
# Debe coincidir EXACTAMENTE con el que pongas en el panel de Meta.
WHATSAPP_VERIFY_TOKEN=malibubot-verificacion-2026

# App Secret (Meta App -> Settings -> Basic -> App Secret). Sirve para
# validar la firma de los webhooks entrantes.
WHATSAPP_APP_SECRET=

# Version de la Graph API. Usa la que muestre tu panel de Meta.
GRAPH_API_VERSION=v21.0

# --- Consola de monitoreo (/admin) ---
# Contrasena para entrar al panel. Sin esto, el panel queda cerrado.
# El usuario puede ser cualquiera; solo se valida la contrasena.
ADMIN_PASSWORD=cambia-esta-clave

# --- Hotel ---
HOTEL_NOMBRE=Hotel y Centro de Eventos Malibu
